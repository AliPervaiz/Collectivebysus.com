{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collectivebysus",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Weekly database backup to R2 (backups/YYYY-MM-DD.json.gz, newest 26 kept). Sundays 09:17 UTC.
  "triggers": { "crons": ["17 9 * * 0"] },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // These paths go through the worker first (auth, private galleries).
    "run_worker_first": ["/admin", "/admin/*", "/api/*", "/g/*"]
  },

  // Resized client-gallery images.
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "collectivebysus-galleries" }
  ],

  // Galleries + favorites. Create with: npx wrangler d1 create collectivebysus-galleries
  // then paste the database_id it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collectivebysus-galleries",
      "database_id": "b7406895-a8dc-4f9f-a677-62322f01cfde",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // From Cloudflare Zero Trust > Settings > Custom Pages (team domain)
    // and the Access application's "Application Audience (AUD) Tag".
    "ACCESS_TEAM_DOMAIN": "aged-sun-d138.cloudflareaccess.com",
    "ACCESS_AUD": "7f9320ef5c512dcb2aa8e840ca6f26ef433d5e8a4b4422b38510cf7a6cd9d550",
    // Optional extra allowlist on top of the Access policy.
    "ADMIN_EMAILS": "",
    "NOTIFY_FROM": "studio@collectivebysus.com",
    // Must be a *verified destination* in Email Routing (not the contact@ alias,
    // which itself forwards here).
    "NOTIFY_TO": "collectivebysus@gmail.com",
    // Client auto-replies: needs RESEND_API_KEY (secret) and a verified sender. Off for now.
    "CLIENT_EMAIL_FROM": "",
    // Optional Cloudflare Turnstile spam check (also needs TURNSTILE_SECRET). Off for now.
    "TURNSTILE_SITE_KEY": ""
  },

  // Emails Susi about new inquiries and gallery submissions. Email Routing is enabled
  // on collectivebysus.com (contact@ forwards to collectivebysus@gmail.com), and
  // this binding can only deliver to that verified address.
  "send_email": [
    { "name": "NOTIFY", "destination_address": "collectivebysus@gmail.com" }
  ]
}
